@page "/login"
@using System.Net
@using Beam.Client.BlazorWasm.Services
@using Beam.UI.Dtos
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject ILocalStorageService localStorage
@inject AuthenticationStateProvider AuthProvider
@inject AuthService _AuthService




@* <h3>Вход в систему</h3> *@

<EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="login-form">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />

    <div class="login-form-group">
        <label for="username">Имя</label>
        <InputText id="username" class="form-control-login" @bind-Value="loginModel.Tag" placeholder="Введите имя" />
    </div>

    <div class="login-form-group">
        <label for="password">Пароль</label>
        <InputText id="password" type="password" class="form-control-login" @bind-Value="loginModel.Password" placeholder="Введите пароль" />
    </div>

    <button type="submit" class="btn btn-login">
        Войти
        <span class="oi oi-arrow-right" aria-hidden="true"></span>
    </button>
</EditForm>

@code {
    private readonly LoginModelDto loginModel = new();
    private string errorMessage;
   

    private async Task HandleLogin()
    {
        try
        {
            var response = await HttpClient.PostAsJsonAsync("/api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var tokenResponse = await response.Content.ReadFromJsonAsync<TokenResponseDto>();

                await localStorage.SetItemAsync("authToken", tokenResponse.Token);
                await _AuthService.RaiseOnLogin();

                var storedToken = await localStorage.GetItemAsync<string>("authToken");

                Console.WriteLine($"Token in localStorage: {storedToken}");
                
                await localStorage.SetItemAsync("userName", loginModel.Tag);
                
                var jwtAuthProvider = (JwtAuthenticationStateProvider)AuthProvider;
                
                jwtAuthProvider.NotifyUserAuthentication(tokenResponse.Token);

                NavigationManager.NavigateTo("/");
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                NavigationManager.NavigateTo("/registration");
                errorMessage = "Вы не зарегистрированы!!!";
            }
            else
            {
                errorMessage = "Ошибка входа. Проверьте имя пользователя и пароль.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Произошла ошибка при входе: " + ex.Message;
        }
    }


}