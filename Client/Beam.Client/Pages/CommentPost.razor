@page "/CommentPost"
@using System.Net.Http.Headers
@using Beam.Client.BlazorWasm.Services
@using Beam.UI.Configuration
@using Beam.UI.Dtos
@using Beam.UI.Interfaces
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject AppSettings settings
@inject ITokenService TokenService






<EditForm Model="commentInputDto" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="form-group">
        <label for="Content"></label>
        <InputTextArea oninput="autoResize(this)" id="Content" @bind-Value="commentInputDto.Content"
                       class="form-control-comment" placeholder="Коментарий..."/>
        <button type="submit" class="btn-comment  fa fa-comments"></button>
    </div>
</EditForm>


@code {
    [Parameter] public Guid PostId { get; set; }
    private CommentInputDto commentInputDto = new();
    private bool isAuthenticated = false;

    private async Task HandleValidSubmit()
    {
        var tokenJson = await LocalStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrEmpty(tokenJson))
        {
            var token = tokenJson;
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity.IsAuthenticated)
            {
                var author = TokenService.GetUserNameFromToken(tokenJson);
                @* var userId = tokenService.GetUserIdFromToken(tokenJson);*@ // Извлекаем userId

                commentInputDto.Author = author;
                @* commentInputDto.UserId = Guid.Parse(userId);*@ // Устанавливаем userId в DTO
            }

            var response = await Http.PostAsJsonAsync($"{settings.ApiBaseUrl}/api/comment/{PostId}", commentInputDto);

            if (response.IsSuccessStatusCode)
            {
                commentInputDto = new CommentInputDto();
            }
        }
        else if (tokenJson == null)
        {
            // Если токена нет, считаем пользователя неавторизованным
        }
    }

}
