@page "/posts"
@using System.Net.Http.Headers
@using System.Text
@using Beam.Application.Services
@using Beam.Application.Services.Interfaces
@using Beam.Infrastructure.Entities
@using Beam.Infrastructure.Hubs
@using Microsoft.AspNetCore.SignalR.Client
@inject IJSRuntime JS
@using Beam.UI.Dtos
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.SignalR
@inject HttpClient Http
@inject ILocalStorageService LocalStorage


@code {
    private List<PostDto> posts = new();
    private bool isLoading = true;
    private ElementReference postListContainer;
    private HubConnection? _hubConnection;
    private readonly IHubContext<ChatHub> _hubContext;

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
        await InitializeSignalRConnection();
    }

    private async Task InitializeSignalRConnection()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token)) return;
        Console.WriteLine($"Токен перед подключением: {token}");
        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5049/chatHub", options => { options.AccessTokenProvider = () => Task.FromResult(token); })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<PostDto>("ReceivePostCreated", HandleNewPostCreated);

        _hubConnection.On<PostDto>("ReceivePostLiked", post =>
        {
            // Обновление лайков по событию из SignalR
            var existingPost = posts.FirstOrDefault(p => p.Id == post.Id);
            if (existingPost != null)
            {
                existingPost.LikesCount = post.LikesCount;
                //existingPost.IsLiked = post.IsLiked;
                StateHasChanged();
            }
        });

        _hubConnection.On<PostDto>("ReceivePostUnLiked", post =>
        {
            // Обновление лайков по событию из SignalR
            var existingPost = posts.FirstOrDefault(p => p.Id == post.Id);
            if (existingPost != null)
            {
                existingPost.LikesCount = post.LikesCount;
                StateHasChanged();
            }
        });
        _hubConnection.On<Guid, bool>("ReceivePostLikedStatus", (postId, isLiked) =>
        {
            var existingPost = posts.FirstOrDefault(p => p.Id == postId);
            if (existingPost != null)
            {
                existingPost.IsLiked = isLiked;
                StateHasChanged();
            }
        });
      

        _hubConnection.Reconnecting += (error) =>
        {
            Console.WriteLine($"Переподключение: {error?.Message}");
            return Task.CompletedTask;
        };

        _hubConnection.Reconnected += (connectionId) =>
        {
            Console.WriteLine($"Подключение восстановлено. ID: {connectionId}");
            return Task.CompletedTask;
        };

        try
        {
            Console.WriteLine("Подключение к SignalR...");
            await _hubConnection.StartAsync();
            Console.WriteLine("SignalR подключен!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка подключения к SignalR: {ex.Message}");
        }
    }

    private readonly object _lock = new object();

    private void UpdateLikeCount(Guid postId, int likeCount)
    {
        lock (_lock)
        {
            var post = posts.FirstOrDefault(p => p.Id == postId);
            if (post != null)
            {
                post.LikesCount = likeCount;
                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Пост с ID {postId} не найден.");
            }
        }
    }

    private async Task LoadPostsAsync()
    {
        try
        {
            isLoading = true;
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var request = new HttpRequestMessage(HttpMethod.Get, "http://localhost:5049/api/Post");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

                var response = await Http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    posts = await response.Content.ReadFromJsonAsync<List<PostDto>>();
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("Не удалось загрузить посты.");
                }
            }
            else
            {
                Console.WriteLine("Токен не найден.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке постов: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleLike(Guid postId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Console.WriteLine("Token is missing.");
                return;
            }
            // Создаем запрос с токеном
            var request = new HttpRequestMessage(HttpMethod.Post, $"http://localhost:5049/api/post/{postId}/likes");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = new StringContent(string.Empty, Encoding.UTF8, "application/json");


            // Отправляем запрос для переключения лайка
            var response = await Http.PostAsync($"http://localhost:5049/api/post/{postId}/likes", new StringContent(""));

            if (response.IsSuccessStatusCode)
            {
                var updatedPost = await response.Content.ReadFromJsonAsync<PostDto>(); 

                if (updatedPost != null)
                {
                    // Обновляем локальное состояние поста
                    var existingPost = posts.FirstOrDefault(p => p.Id == updatedPost.Id);
                    if (existingPost != null)
                    {
                        existingPost.IsLiked = updatedPost.IsLiked;
                        existingPost.LikesCount = updatedPost.LikesCount;
                        StateHasChanged();
                    }
                }
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Ошибка: {response.StatusCode}, {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при отправке запроса: {ex.Message}");
        }
    }

    public async Task HandleNewPostCreated(PostDto newPost)
    {
        Console.WriteLine("Новый пост получен: " + newPost.Id);
        // Проверяем, существует ли уже пост с таким же Id
        if (!posts.Any(p => p.Id == newPost.Id))
        {
            posts.Insert(0, newPost); // Добавляем новый пост в начало списка
            await InvokeAsync(StateHasChanged);
        }
    }
    
   
    private async Task ScrollToBottomAsync()
    {
        await Task.Delay(100);
        await JS.InvokeVoidAsync("scrollToBottom", postListContainer);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

}

@if (isLoading)
{
    <p>Загрузка постов...</p>
}
else if (posts == null || !posts.Any())
{
    <p>Постов пока нет.</p>
}
else
{
    <div class="post-list-container">
        <div class="post-list" @ref="postListContainer">
            @foreach (var post in posts)
            {
                <div class="gradient-line"></div>
                <div class="post-item  p-3">
                    <div class="post-content">
                        <p>@post.Content</p>
                        <div class="post-footer">
                            <div class="user-like">
                                <p>@post.UserName</p>
                                <div class="like-section">
                                    <p class="like-count">@post.LikesCount</p>
                                    <button @onclick="() => ToggleLike(post.Id)" class="like-button">
                                        @if (post.IsLiked)
                                        {
                                            <i class="fas fa-heart" style="color: red;"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-heart" style="color: grey;"></i>
                                        }
                                    </button>
                                </div>
                            </div>

                            <small class="creation-date">@post.CreationDate.ToString("g")</small>
                        </div>
                    </div>
                    <div class="comment-block">
                        <CommentPost PostId="@post.Id"/>
                        <CommentList PostId="@post.Id" @key="post.Id"/>
                    </div>

                </div>
            }
        </div>

        <div class="create-post-footer">
            <CreatePost OnPostCreated="HandleNewPostCreated"/>
        </div>
    </div>
}
