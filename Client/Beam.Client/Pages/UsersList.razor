@page "/usersList"
@using System.IdentityModel.Tokens.Jwt
@using System.Net.Http.Headers
@using Beam.Client.BlazorWasm.Services
@using Beam.Shared.Dto
@using Beam.UI.Configuration
@using Beam.UI.Dtos
@using Beam.UI.Interfaces
@using Blazored.LocalStorage
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject AppSettings settings
@inject ITokenService TokenService
@inject SignalService SignalRService
@inject AuthService _AuthService

<h3></h3>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (users is not null && users.Any())
{
    <div class="userList-container">
        <ul>
            @foreach (var user in users)
            {
                <li class="user-item @(NewMessageUsers.Contains(user.Id) ? "blink" : "")">
                    <a href="@($"/chat/{user.Id}")" @onclick="() => OpenChat(user.Id)" class="user-link">
                        @user.Tag - @(OnlineUsers.ContainsKey(user.Id) && OnlineUsers[user.Id] ? "🟢" : "⚪")
                        @if (SignalRService.UsersTyping.ContainsKey(user.Id)&& SignalRService.UsersTyping[user.Id])
                        {
                            <span class="typing-dots">
                                <span></span><span></span><span></span><span class="typing-text">typing</span>
                            </span>
                        }
                    </a>
                </li>
            }
        </ul>
    </div>
}
else
{
    <p>Пользователи не найдены.</p>
}

@code {
    private List<UserDto> users = new();
    private bool isLoading = true;
    private Guid currentUserId = Guid.Empty;
    private Dictionary<Guid, bool> OnlineUsers => SignalRService.OnlineUsers;
    private HashSet<Guid> NewMessageUsers => SignalRService.NewMessageUsers;


    protected override async Task OnInitializedAsync()
    {
        _AuthService.OnLogin += HandleLogin;

        _AuthService.OnLogout += HandleLogout;

        SignalRService.OnUsersStatusChanged += HandleUserStatusChanged;
        SignalRService.OnUsersListUpdated += HandleUserListUpdated;
        SignalRService.OnNewMessage += HandleNewMessage;
        SignalRService.OnUsersTypingChanged += () => InvokeAsync(StateHasChanged);


    }



    private async Task HandleLogin()
    {
        await SignalRService.StartAsync();
        await LoadUsersAsync();
    }


    private Task HandleLogout()
    {
        users.Clear();
        OnlineUsers.Clear();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void HandleUserStatusChanged(Guid userId, bool isOnline)
    {
        StateHasChanged();
    }

    private async Task HandleUserListUpdated()
    {
        // Сервер сообщил, что список пользователей обновился
        await LoadUsersAsync();
    }

    private void HandleNewMessage(Guid fromUserId, string lastMessageText)
    {
        StateHasChanged();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(token))
            {
                return;
            }

            var request = new HttpRequestMessage(HttpMethod.Get, $"{settings.ApiBaseUrl}/api/users");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                users = await response.Content.ReadFromJsonAsync<List<UserDto>>() ?? new List<UserDto>();
                foreach (var user in users)
                {
                    if (!OnlineUsers.ContainsKey(user.Id))
                        OnlineUsers[user.Id] = user.IsOnline;
                }
            }
            else
            {
                Console.WriteLine("Не удалось загрузить пользователей.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке пользователей: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenChat(Guid userId)
    {
        // Открываем чат (например, навигация на /chat/{userId})
        Navigation.NavigateTo($"/chat/{userId}");

        // Сбрасываем флаг непрочитанного сообщения
        SignalRService.ClearNewMessage(userId);
    }

    public void Dispose()
    {
        _AuthService.OnLogin -= HandleLogin;
        _AuthService.OnLogout -= HandleLogout;
        SignalRService.OnUsersStatusChanged -= HandleUserStatusChanged;
        SignalRService.OnUsersListUpdated -= HandleUserListUpdated;
        SignalRService.OnNewMessage -= HandleNewMessage;
    }

}