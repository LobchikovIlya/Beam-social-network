@page "/usersList"
@using System.IdentityModel.Tokens.Jwt
@using Beam.UI.Dtos
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Security.Claims
@using Beam.UI.Configuration
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inject NavigationManager Navigation
@inject HubConnection _HubConnection
@inject AppSettings settings

<h4>Пользователи</h4>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (users is not null && users.Any())
{
    <div class="userList-container">
        <ul>
            @foreach (var user in users)
            {
                <li class="user-item">
                    <a href="@($"/chat/{user.Id}")" class="user-link">
                        @user.Tag - @(OnlineUsers.ContainsKey(user.Id) && OnlineUsers[user.Id] ? "🟢" : "⚪")
                    </a>
                </li>
            }
        </ul>
    </div>
   
}
else
{
    <p>Пользователи не найдены.</p>
}

@code {
    private List<UserDto> users = new();
    private bool isLoading = true;
    private Guid userId = Guid.Empty;
    private Dictionary<Guid, bool> OnlineUsers = new();
  

    protected override async Task OnInitializedAsync()
    {
       
        await LoadUsersAsync();
        await SetupSignalAsync();
       
       
    }

    private async Task SetupSignalAsync()
    {
        var tokenJson = await LocalStorage.GetItemAsync<string>("authToken");
        Console.WriteLine("Token from localStorage:", tokenJson);
        var currentUserId = await GetUserIdFromTokenAsync();

        if (string.IsNullOrEmpty(tokenJson) || !currentUserId.HasValue)
        {
            Console.WriteLine("Token or UserId is missing, skipping SignalR setup.");
            return; 
        }
        Console.WriteLine($"Token from LocalStorage: {tokenJson}");
        
            _HubConnection.On<Guid, bool>("UsersStatusChanged", (userId, isOnline) =>
            {
                OnlineUsers[userId] = isOnline;

                StateHasChanged();  // Обновление компонента
            });
            _HubConnection.On("UserListUpdated", async () =>
            {
                Console.WriteLine("📡 Получено событие 'UserListUpdated'. Перезагружаю список пользователей...");
                await LoadUsersAsync();
            });

            try
            {
                if (_HubConnection.State == HubConnectionState.Disconnected)
                {
                    await _HubConnection.StartAsync();
                }
                Console.WriteLine("SignalR connection started successfully.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error starting SignalR connection: {ex.Message}");
            }
        
    }

    private async Task<Guid?> GetUserIdFromTokenAsync()
    {
        var tokenJson = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(tokenJson))
            return null;

        var handler = new JwtSecurityTokenHandler();
        var token = handler.ReadJwtToken(tokenJson);
        var userIdClaim = token.Claims.FirstOrDefault(c => c.Type == "sub"); // "sub" – стандартное имя для ID пользователя

        if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out Guid userId))
        {
            return userId;
        }

        return null;
    }


    private async Task LoadUsersAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(token))
            {
                var handler = new JwtSecurityTokenHandler();
                var jwt = handler.ReadJwtToken(token);
                foreach (var claim in jwt.Claims)
                {
                    Console.WriteLine($"Claim: {claim.Type} = {claim.Value}");
                }
                var userIdClaims =jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier
                    ||c.Type == "sub"
                    || c.Type == "uid")?.Value;
                
                var request = new HttpRequestMessage(HttpMethod.Get, $"{settings.ApiBaseUrl}/api/users");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                var response = await Http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    users = await response.Content.ReadFromJsonAsync<List<UserDto>>() ?? new();
                    foreach (var user in users)
                    {
                        OnlineUsers[user.Id] = user.IsOnline;
                    }
                    StateHasChanged();
                  
                }
                else
                {
                    Console.WriteLine("Не удалось загрузить пользователей.");
                }
            }
            else
            {
                Console.WriteLine("Токен не найден.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке пользователей: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}