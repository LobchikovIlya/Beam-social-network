@page "/CommentList"
@using System.Text
@using Beam.Infrastructure.Entities
@using Beam.Shared.Dto
@using Beam.UI.Configuration
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HubConnection _HubConnection
@inject AppSettings settings



@code {
    [Parameter] public Guid PostId { get; set; }
    private List<CommentDto> comments = new();
    private bool isLoading = true;
    private ElementReference commentListContainer;

    protected override async Task OnParametersSetAsync()
    {
        await InitializeSignalRAsync();
        await LoadCommentsAsync(PostId);
        await LoadAllCommentLikesAsync();
    }

    private async Task ReconnectSignalRAsync()
    {
        if (_HubConnection != null)
        {
            await _HubConnection.StopAsync();
            await _HubConnection.DisposeAsync();
        }

        await InitializeSignalRAsync();
    }


    private async Task InitializeSignalRAsync()
    {
        var tokenJson = await LocalStorage.GetItemAsync<string>("authToken");

        if (!string.IsNullOrEmpty(tokenJson))
        {
            _HubConnection.On<CommentDto>("ReceiveCommentCreated", HandleNewComment);
            _HubConnection.On<CommentDto>("ReceiveCommentLikedStatus", HandleCommentLikeStatus);
            _HubConnection.On<CommentDto>("ReceiveCommentUnLiked", HandleCommentUnLikeStatus);
            _HubConnection.On<CommentDto>("ReceiveCommentUpdated", HandleCommentUpdate);
            if (_HubConnection.State == HubConnectionState.Disconnected)
            {
                await _HubConnection.StartAsync();
            }

            await _HubConnection.InvokeAsync("JoinGroup", PostId.ToString());
        }
    }

    private async Task LoadCommentsAsync(Guid postId)
    {
        try
        {
            isLoading = true;
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                var response = await Http.GetAsync($"{settings.ApiBaseUrl}/api/comment/{postId}");
                if (response.IsSuccessStatusCode)
                {
                    var loadedComments = await response.Content.ReadFromJsonAsync<List<CommentDto>>() ?? new List<CommentDto>();
                    comments = loadedComments.OrderByDescending(c => c.CreationDate).ToList();
                    StateHasChanged();
                }
                else
                {
                    Console.WriteLine("Не удалось загрузить комментарии.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке комментов: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    private readonly object _lock = new();

    private void UpdateCommentLikeCount(Guid commentId, int likeCount)
    {
        lock (_lock)
        {
            var comment = comments.FirstOrDefault(c => c.Id == commentId);
            if (comment != null)
            {
                comment.LikesCount = likeCount;
                StateHasChanged();
            }
        }
    }


    private async Task HandleNewComment(CommentDto newComment)
    {
        if (newComment.PostId == PostId && comments.All(c => c.Id != newComment.Id))
        {
            comments.Insert(0, newComment);
            await InvokeAsync(StateHasChanged); // Принудительно вызываем обновление UI
        }
    }

    private void HandleCommentLikeStatus(CommentDto comment)
    {
        var existingComment = comments.FirstOrDefault(c => c.Id == comment.Id);
        if (existingComment != null)
        {
            existingComment.LikesCount = comment.LikesCount;
            InvokeAsync(StateHasChanged); // Обновить UI
        }
    }

    private void HandleCommentUnLikeStatus(CommentDto comment)
    {
        var existingComment = comments.FirstOrDefault(c => c.Id == comment.Id);
        if (existingComment != null)
        {
            existingComment.LikesCount = comment.LikesCount;
            if (existingComment.Id == comment.Id)
            {
                existingComment.IsLiked = comment.IsLiked;
            }

            InvokeAsync(StateHasChanged); // Обновить UI
        }
    }

    private void HandleCommentUpdate(CommentDto comment)
    {
        var existingComment = comments.FirstOrDefault(c => c.Id == comment.Id);
        if (existingComment != null)
        {
            existingComment.Content = comment.Content;
            existingComment.LikesCount = comment.LikesCount;
            InvokeAsync(StateHasChanged); // Обновить UI
        }
    }

    public async Task DisposeAsync()
    {
        if (_HubConnection != null)
        {
            // Удаляем из группы при отключении компонента
            await _HubConnection.InvokeAsync("LeaveGroup", PostId.ToString());
            await _HubConnection.DisposeAsync();
        }
    }

    private async Task LoadAllCommentLikesAsync()
    {
        if (comments == null || comments.Count == 0)
            return;

        var tasks = comments.Select(c => LoadCommentLikesAsync(c.Id));
        await Task.WhenAll(tasks);
        StateHasChanged();
    }


    private async Task LoadCommentLikesAsync(Guid commentId)
    {
        Console.WriteLine($"Загружаю лайки для комментария с ID: {commentId}");

        try
        {
            // Запрос на сервер для получения лайков для конкретного комментария
            var response = await Http.GetAsync($"{settings.ApiBaseUrl}/api/comment/{commentId}/likes/count");

            if (response.IsSuccessStatusCode)
            {
                // Чтение лайков из ответа
                var result = await response.Content.ReadFromJsonAsync<List<CommentLike>>() ?? new List<CommentLike>();

                // Обновляем количество лайков
                var comment = comments.FirstOrDefault(c => c.Id == commentId);
                if (comment != null)
                {
                    comment.LikesCount = result.Count;
                }

                // Проверяем, лайкнул ли текущий пользователь этот комментарий
                var userId = await LocalStorage.GetItemAsync<string>("userId");
                var likedComment = result.FirstOrDefault(like => like.UserId.ToString() == userId);
                if (comment != null)
                {
                    comment.IsLiked = likedComment != null;
                }

                Console.WriteLine($"Количество лайков: {comment?.LikesCount}, Лайкнул ли пользователь: {comment?.IsLiked}");
                StateHasChanged(); // Обновление UI
            }
            else
            {
                Console.WriteLine($"Ошибка при загрузке лайков: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }


    private async Task ToggleLike(Guid commentId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (string.IsNullOrEmpty(token))
            {
                Console.WriteLine("Token is missing.");
                return;
            }

            var response = await Http.PostAsync($"{settings.ApiBaseUrl}/api/comment/{commentId}/likes", new StringContent("", Encoding.UTF8, "application/json"));


            if (response.IsSuccessStatusCode)
            {
                var updatedComment = await response.Content.ReadFromJsonAsync<CommentDto>();

                if (updatedComment != null && updatedComment.Id == commentId)
                {
                    var existingComment = comments.FirstOrDefault(c => c.Id == updatedComment.Id);
                    if (existingComment != null)
                    {
                        existingComment.IsLiked = updatedComment.IsLiked;
                        existingComment.LikesCount = updatedComment.LikesCount;
                        InvokeAsync(StateHasChanged);
                    }
                }
            }
            else
            {
                Console.WriteLine($"Ошибка: {response.StatusCode}, {await response.Content.ReadAsStringAsync()}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при отправке запроса: {ex.Message}");
        }
    }

    private async Task ScrollToBottomAsync()
    {
        await Task.Delay(200);
        await JS.InvokeVoidAsync("scrollToBottom", commentListContainer);
    }

}

@if (isLoading)
{
    <p>Загрузка комментариев...</p>
}
else if (comments == null || !comments.Any())
{
    <p>Комментариев пока нет.</p>
}
else
{
    <div class="comment-list" @ref="commentListContainer">
        @foreach (var comment in comments)
        {
            var showComments = false;

            <div class="post-item  p-0">
                <div class="comment-content">
                    <p class="text-post">@comment.Content</p>
                    <div class="comment-footer">
                        <div class="user-like">
                            <p>@comment.Author</p>
                            <div class="like-section">
                                <p class="like-count">@comment.LikesCount</p>
                                <button @onclick="() => ToggleLike(comment.Id)" class="like-button">
                                    @if (comment.IsLiked)
                                    {
                                        <i class="fas fa-heart" style="color: red;"></i>
                                        <!-- Красное сердце -->
                                    }
                                    else
                                    {
                                        <i class="far fa-heart" style="color: grey;"></i>
                                        <!-- Серое сердце -->
                                    }
                                </button>
                            </div>
                        </div>
                        <small class="creation-date "> @comment.CreationDate.ToString("g")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}